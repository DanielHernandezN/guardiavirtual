# ─────────────────────────────────────────────────────────────
# Guardia Virtual — Variables de entorno
# Copia este archivo a `.env.local` y completa los valores.
# `.env.local` está ignorado por git (ver .gitignore).
# ─────────────────────────────────────────────────────────────

# Clave de API del proveedor de IA.
# El endpoint app/api/chat/route.ts usa OPENROUTER_API_KEY
# (o OPENAI_API_KEY como alternativa).
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=tu_clave_aqui

# Modelo por defecto. Ejemplos de OpenRouter:
#   openai/gpt-4o-mini
#   anthropic/claude-3.5-sonnet
#   google/gemini-flash-1.5
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── Alternativa: OpenAI directo (descomenta si no usas OpenRouter) ──
# OPENAI_API_KEY=tu_clave_openai
# OPENAI_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────────────────────
# Autenticación
# ─────────────────────────────────────────────────────────────

# Secreto usado para firmar las cookies de sesión (HMAC-SHA256).
# Genera uno con:  openssl rand -base64 32
SESSION_SECRET=cambia_este_secreto_por_uno_aleatorio

# Funcionarios con acceso, en formato JSON.
# Si no se define, se usa el usuario de demostración:
#   ID: daniel.hernandez  /  PASS: Guardia2026
# USUARIOS_JSON=[{"id":"daniel.hernandez","nombre":"Daniel Hernández Norambuena","password":"Guardia2026"}]
