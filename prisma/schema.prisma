// ─────────────────────────────────────────────────────────────
// Esquema de base de datos — Guardia Virtual
// ─────────────────────────────────────────────────────────────
// Fuente: https://pris.ly/d/prisma-schema
//
// Para producción (Vercel + Postgres) basta con:
//   1. Cambiar el proveedor: `npm run db:use:postgres`
//   2. Apuntar DATABASE_URL a la URL de Postgres
//   3. Sincronizar el esquema: `npx prisma db push`
//
// Ver la guía de despliegue en DEPLOY.md y el capítulo de Prisma en la
// documentación de Next.js:
// https://nextjs.org/docs/app/building-your-application/data-fetching/prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Funcionario con acceso al sistema.
/// La fuente de verdad de las credenciales es `USUARIOS_JSON`; esta tabla
/// se sincroniza al iniciar sesión y da integridad referencial a los casos.
model Usuario {
  id           String   @id
  /// Nombre completo del funcionario.
  nombre       String
  /// Hash `scrypt` de la contraseña (formato `salt:hash`).
  passwordHash String
  /// `false` para desactivar el acceso sin borrar su historial.
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  casos Caso[]

  @@index([activo])
}

/// Un procedimiento trabajado por un funcionario.
/// Guarda los antecedentes y sus borradores generados.
model Caso {
  id                String   @id @default(cuid())
  /// Título legible del caso (ej: "Hurto de bicicleta").
  titulo            String
  /// Tipo de procedimiento (hurto, robo, accidente...).
  tipoProcedimiento String?
  /// Especie involucrada.
  especie           String?
  /// Lugar de ocurrencia.
  lugar             String?
  /// Fecha del hecho en formato dd/mm/yyyy.
  fecha             String?
  /// Estado del caso: BORRADOR | CONFIRMADO.
  estado            String   @default("BORRADOR")
  /// Antecedentes estructurados, serializados como JSON.
  antecedentes      String   @default("{}")
  /// Metadatos del documento de origen y trazabilidad (JSON): plantilla,
  /// hash del archivo, observaciones y extractos de respaldo por campo.
  documento         String?
  /// ID del funcionario (sincronizado con la tabla `Usuario`).
  usuarioId         String
  /// Fecha de eliminación (papelera). `null` si el caso está activo.
  eliminadoEn       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  usuario Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  borradores Borrador[]

  @@index([usuarioId, createdAt])
  @@index([estado])
  @@index([eliminadoEn])
}

/// Borrador del parte generado por la IA para un caso.
/// Puede haber varios (el funcionario edita y vuelve a generar).
model Borrador {
  id           String    @id @default(cuid())
  casoId       String
  titulo       String
  /// Secciones del parte, serializadas como JSON.
  secciones    String    @default("[]")
  /// Texto plano completo del parte.
  texto        String
  /// Estado del borrador: BORRADOR | CONFIRMADO.
  estado       String    @default("BORRADOR")
  /// Plantilla usada al generar (`id@version`), para trazabilidad.
  plantilla    String?
  generadoEn   DateTime  @default(now())
  confirmadoEn DateTime?

  caso Caso @relation(fields: [casoId], references: [id], onDelete: Cascade)

  @@index([casoId, generadoEn])
}
