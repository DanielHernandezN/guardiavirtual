# ─────────────────────────────────────────────────────────────
# .gitattributes — normalización de archivos para todo el equipo
# ─────────────────────────────────────────────────────────────

# Normaliza los finales de línea a LF, tanto en el repositorio como en la
# carpeta de trabajo (uniforme en Windows, macOS y Linux). Evita diffs
# ruidosos y los warnings "LF/CRLF will be replaced by ...".
* text=auto eol=lf

# Scripts de Windows: deben conservar CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Archivos binarios: Git no debe intentar convertir ni hacer diff.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary

# Diffs más legibles para Markdown.
*.md diff=markdown

# Reduce el ruido en diffs grandes de dependencias.
package-lock.json -diff
